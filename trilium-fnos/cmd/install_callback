#!/bin/bash
set -eu

RUNTIME_ROOT="${TRIM_PKGVAR}/runtime"
CURRENT_LINK="${RUNTIME_ROOT}/current"
VERSION_FILE="${RUNTIME_ROOT}/current-version"

mkdir -p "${TRIM_PKGVAR}/trilium-data" "$RUNTIME_ROOT"

if [ -n "${TRIM_DATA_SHARE_PATHS:-}" ]; then
  BACKUP_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
else
  BACKUP_DIR="${TRIM_PKGVAR}/update-backups"
fi

mkdir -p "$BACKUP_DIR"

if [ ! -e "$CURRENT_LINK" ] && [ ! -L "$CURRENT_LINK" ]; then
  ln -s "${TRIM_APPDEST}/server" "$CURRENT_LINK"
fi

if [ ! -s "$VERSION_FILE" ]; then
  cp "${CURRENT_LINK}/VERSION" "${VERSION_FILE}.init-$$"
  mv -f "${VERSION_FILE}.init-$$" "$VERSION_FILE"
fi
exit 0
