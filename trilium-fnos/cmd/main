#!/bin/bash
set -u
export PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

PROXY_PID_FILE="${TRIM_PKGVAR}/proxy.pid"
BACKEND_PID_FILE="${TRIM_PKGVAR}/backend.pid"
PROXY_LOG_FILE="${TRIM_PKGVAR}/proxy.log"
BACKEND_LOG_FILE="${TRIM_PKGVAR}/trilium.log"
RUNTIME_ROOT="${TRIM_PKGVAR}/runtime"
CURRENT_LINK="${RUNTIME_ROOT}/current"
VERSION_FILE="${RUNTIME_ROOT}/current-version"
PROXY_DIR="${TRIM_APPDEST}/proxy"
PROXY_NODE="${TRIM_APPDEST}/server/node/bin/node"
PUBLIC_PORT="${TRIM_SERVICE_PORT:-8080}"
BACKEND_PORT="18888"
GATEWAY_SOCKET="${TRIM_APPDEST}/app.sock"
LOCK_DIR="${TRIM_PKGTMP:-${TRIM_PKGVAR}}/lifecycle.lock"

write_error() {
  [ -n "${TRIM_TEMP_LOGFILE:-}" ] && printf '%s\n' "$1" > "$TRIM_TEMP_LOGFILE"
  printf '%s\n' "$1" >&2
}

read_pid() {
  local value
  [ -f "$1" ] || return 1
  value="$(head -n 1 "$1")"
  case "$value" in ''|*[!0-9]*) return 1 ;; esac
  [ "$value" -gt 1 ] || return 1
  printf '%s' "$value"
}

process_matches() {
  local pid="$1" marker="$2" executable expected
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  [ "$pid" -gt 1 ] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  [ -r "/proc/${pid}/cmdline" ] || return 1
  executable="$(readlink -f "/proc/${pid}/exe" 2>/dev/null || true)"
  if [ "$marker" = "${PROXY_DIR}/server.js" ]; then
    expected="$(readlink -f "$PROXY_NODE" 2>/dev/null || true)"
  else
    expected="$(readlink -f "${marker%/*}/node/bin/node" 2>/dev/null || true)"
  fi
  [ -n "$expected" ] && [ "$executable" = "$expected" ] || return 1
  tr '\0' '\n' < "/proc/${pid}/cmdline" | grep -Fxq -- "$marker"
}

pid_running() {
  local file="$1" marker="$2" pid
  pid="$(read_pid "$file" 2>/dev/null || true)"
  [ -n "$pid" ] && process_matches "$pid" "$marker"
}

find_our_pids() {
  local marker="$1" cmdline pid
  for cmdline in /proc/[0-9]*/cmdline; do
    [ -r "$cmdline" ] || continue
    pid="${cmdline#/proc/}"
    pid="${pid%/cmdline}"
    if process_matches "$pid" "$marker"; then
      printf '%s\n' "$pid"
    fi
  done
}

stop_matching() {
  local marker="$1" pids count alive pid
  pids="$(find_our_pids "$marker")"
  [ -n "$pids" ] || return 0
  kill -TERM $pids 2>/dev/null || true
  count=0
  while [ "$count" -lt 30 ]; do
    alive=""
    for pid in $pids; do
      process_matches "$pid" "$marker" && alive="$alive $pid"
    done
    [ -z "$alive" ] && return 0
    sleep 1
    count=$((count + 1))
  done
  kill -KILL $alive 2>/dev/null || true
}

stop_pid() {
  local file="$1" marker="$2" pid count
  pid="$(read_pid "$file" 2>/dev/null || true)"
  if [ -n "$pid" ] && process_matches "$pid" "$marker"; then
    kill -TERM "$pid" 2>/dev/null || true
    count=0
    while process_matches "$pid" "$marker" && [ "$count" -lt 30 ]; do
      sleep 1
      count=$((count + 1))
    done
    process_matches "$pid" "$marker" && kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f "$file"
}

port_open() {
  (exec 3<>"/dev/tcp/127.0.0.1/$1") >/dev/null 2>&1
}

gateway_ready() {
  [ -S "$GATEWAY_SOCKET" ]
}

wait_ready() {
  local file="$1" marker="$2" port="$3" limit="$4" count
  count=0
  while [ "$count" -lt "$limit" ]; do
    pid_running "$file" "$marker" || return 1
    port_open "$port" && return 0
    sleep 1
    count=$((count + 1))
  done
  return 1
}

acquire_lock() {
  local count
  mkdir -p "$(dirname "$LOCK_DIR")"
  count=0
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    [ "$count" -ge 30 ] && return 1
    sleep 1
    count=$((count + 1))
  done
  trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT
}

backend_marker() {
  local runtime
  runtime="$(readlink -f "$CURRENT_LINK" 2>/dev/null || true)"
  [ -n "$runtime" ] && printf '%s/main.cjs' "$runtime"
}

start_backend() {
  local marker RUNTIME_DIR count
  marker="$(backend_marker)"
  if [ -n "$marker" ] && pid_running "$BACKEND_PID_FILE" "$marker"; then
    # Reuse a healthy instance.  If it is a stale process from an older
    # package, give a normal startup
    # a few seconds to expose the configured backend port, then replace it
    # safely by identity.
    port_open "$BACKEND_PORT" && return 0
    count=0
    while [ "$count" -lt 10 ] && pid_running "$BACKEND_PID_FILE" "$marker"; do
      port_open "$BACKEND_PORT" && return 0
      sleep 1
      count=$((count + 1))
    done
    pid_running "$BACKEND_PID_FILE" "$marker" && stop_pid "$BACKEND_PID_FILE" "$marker"
  fi
  rm -f "$BACKEND_PID_FILE"
  [ -z "$marker" ] || stop_matching "$marker"
  port_open "$BACKEND_PORT" && { write_error "后端端口 ${BACKEND_PORT} 已被其他进程占用。"; return 1; }

  [ -L "$CURRENT_LINK" ] || { write_error "Trilium 运行时指针不存在，请重新安装应用。"; return 1; }
  RUNTIME_DIR="$(readlink -f "$CURRENT_LINK")"
  [ -x "${RUNTIME_DIR}/node/bin/node" ] && [ -f "${RUNTIME_DIR}/main.cjs" ] || {
    write_error "Trilium 原生运行时不完整：${RUNTIME_DIR}"
    return 1
  }

  mkdir -p "${TRIM_PKGVAR}/trilium-data"
  cd "$RUNTIME_DIR" || return 1
  # Trilium 0.105 expects the trusted reverse proxy setting to be an IP
  # address (not the boolean string used by older releases).
  TRILIUM_DATA_DIR="${TRIM_PKGVAR}/trilium-data" \
  TRILIUM_NETWORK_HOST="127.0.0.1" \
  TRILIUM_NETWORK_PORT="$BACKEND_PORT" \
  TRILIUM_NETWORK_TRUSTEDREVERSEPROXY="127.0.0.1" \
  nohup "${RUNTIME_DIR}/node/bin/node" "${RUNTIME_DIR}/main.cjs" >> "$BACKEND_LOG_FILE" 2>&1 &
  printf '%s\n' "$!" > "$BACKEND_PID_FILE"

  # The database can take a while to open or migrate.  fnOS only needs the
  # public proxy to be listening before it considers the app enabled; the
  # proxy shows a retry page while this native backend becomes healthy.
  local count=0
  while [ "$count" -lt 10 ]; do
    pid_running "$BACKEND_PID_FILE" "${RUNTIME_DIR}/main.cjs" && return 0
    sleep 1
    count=$((count + 1))
  done
  stop_pid "$BACKEND_PID_FILE" "${RUNTIME_DIR}/main.cjs"
  write_error "Trilium 后端进程未能保持运行，请查看 ${BACKEND_LOG_FILE}"
  return 1
}

start_proxy() {
  local BACKUP_DIR
  pid_running "$PROXY_PID_FILE" "${PROXY_DIR}/server.js" && port_open "$PUBLIC_PORT" && gateway_ready && return 0
  rm -f "$PROXY_PID_FILE"
  stop_matching "${PROXY_DIR}/server.js"
  port_open "$PUBLIC_PORT" && { write_error "入口端口 ${PUBLIC_PORT} 已被其他进程占用。"; return 1; }
  [ -x "$PROXY_NODE" ] || { write_error "Trilium 内置 Node.js 运行时缺失。"; return 1; }

  if [ -n "${TRIM_DATA_SHARE_PATHS:-}" ]; then BACKUP_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"; else BACKUP_DIR="${TRIM_PKGVAR}/update-backups"; fi
  mkdir -p "$BACKUP_DIR" "${TRIM_PKGVAR}/failed-upgrades" "${RUNTIME_ROOT}/versions" "${RUNTIME_ROOT}/downloads"
  cd "$PROXY_DIR" || return 1
  TRILIUM_PUBLIC_PORT="$PUBLIC_PORT" TRILIUM_BACKEND_PORT="$BACKEND_PORT" \
  TRILIUM_GATEWAY_SOCKET="$GATEWAY_SOCKET" \
  TRILIUM_DATA_DIR="${TRIM_PKGVAR}/trilium-data" TRILIUM_BACKUP_DIR="$BACKUP_DIR" \
  TRILIUM_FAILED_DIR="${TRIM_PKGVAR}/failed-upgrades" TRILIUM_RUNTIME_ROOT="$RUNTIME_ROOT" \
  TRILIUM_CURRENT_LINK="$CURRENT_LINK" TRILIUM_VERSION_FILE="$VERSION_FILE" \
  TRILIUM_RELEASE_ARCH="${TRILIUM_RELEASE_ARCH:-__RELEASE_ARCH__}" \
  TRILIUM_BACKEND_PID_FILE="$BACKEND_PID_FILE" TRILIUM_BACKEND_LOG_FILE="$BACKEND_LOG_FILE" \
  TRILIUM_LOG_FILE="${TRIM_PKGVAR}/update.log" \
  nohup "$PROXY_NODE" "${PROXY_DIR}/server.js" >> "$PROXY_LOG_FILE" 2>&1 &
  printf '%s\n' "$!" > "$PROXY_PID_FILE"

  if ! wait_ready "$PROXY_PID_FILE" "${PROXY_DIR}/server.js" "$PUBLIC_PORT" 30 || ! gateway_ready; then
    stop_pid "$PROXY_PID_FILE" "${PROXY_DIR}/server.js"
    write_error "Trilium 桌面入口未能启动，请查看 ${PROXY_LOG_FILE}"
    return 1
  fi
}

start_app() {
  local marker
  acquire_lock || { write_error "另一个 Trilium 启停操作仍在进行，请稍后重试。"; return 1; }
  # Bring up the fnOS-facing listener first.  Trilium's native server may
  # spend minutes migrating its database; keeping the proxy alive prevents
  # fnOS from marking the app as disabled during that normal startup window.
  start_proxy || return 1
  start_backend || {
    stop_pid "$PROXY_PID_FILE" "${PROXY_DIR}/server.js"
    stop_matching "${PROXY_DIR}/server.js"
    return 1
  }
}

stop_app() {
  local marker
  acquire_lock || { write_error "另一个 Trilium 启停操作仍在进行，请稍后重试。"; return 1; }
  stop_pid "$PROXY_PID_FILE" "${PROXY_DIR}/server.js"
  stop_matching "${PROXY_DIR}/server.js"
  marker="$(backend_marker)"
  if [ -n "$marker" ]; then
    stop_pid "$BACKEND_PID_FILE" "$marker"
    stop_matching "$marker"
  else
    rm -f "$BACKEND_PID_FILE"
  fi
}

case "${1:-}" in
  start) start_app ;;
  stop) stop_app ;;
  status)
    marker="$(backend_marker)"
    if [ -n "$marker" ] && pid_running "$PROXY_PID_FILE" "${PROXY_DIR}/server.js" && \
       pid_running "$BACKEND_PID_FILE" "$marker" && port_open "$PUBLIC_PORT" && gateway_ready; then exit 0; fi
    exit 3
    ;;
  *) write_error "Usage: $0 {start|stop|status}"; exit 1 ;;
esac
